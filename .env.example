# Cadena de conexión PostgreSQL (obligatoria)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Esquema de lectura (cadena de cafeterías)
SQL_DEFAULT_SCHEMA="coffee_chain"

# Esquema sandbox para escritura segura
SQL_SANDBOX_SCHEMA="sql_playground"

# Límites de ejecución
SQL_MAX_ROWS="200"
SQL_STATEMENT_TIMEOUT_MS="8000"

# Tutoría IA opcional (no requerida)
# AI_TUTOR_ENABLED="false"
# OPENAI_API_KEY=""
