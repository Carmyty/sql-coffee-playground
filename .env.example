# Cadena de conexión a PostgreSQL (obligatoria en producción y local).
# Ejemplo local:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sqlcoffee?schema=public"
DATABASE_URL="postgresql://sqlcoffee:sqlcoffee_dev@localhost:5432/sqlcoffee"

# Esquema de lectura por defecto (la cadena de cafeterías).
SQL_DEFAULT_SCHEMA="coffee_chain"

# Esquema de práctica segura para CREATE / ALTER / DROP / INSERT / UPDATE / DELETE.
SQL_SANDBOX_SCHEMA="sql_playground"

# Límite de filas devueltas por consulta de lectura.
SQL_MAX_ROWS="200"

# Tiempo máximo de ejecución por consulta, en milisegundos.
SQL_STATEMENT_TIMEOUT_MS="8000"

# Opcional: más adelante puedes conectar un tutor de IA sin romper la tutoría local.
# OPENAI_API_KEY=""
# AI_TUTOR_ENABLED="false"
